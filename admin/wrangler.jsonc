{
  "name": "perfumesnap-admin",
  "main": "src/index.ts",
  "compatibility_date": "2025-04-01",
  // Secret: npx wrangler secret put ADMIN_KEY
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "perfumesnap-db",
      "database_id": "b213b69e-8666-4f3d-99a4-c3d430fc2ee4"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "perfumesnap-images"
    }
  ],
  "vars": {
    "MEDIA_BASE_URL": "https://media.perfumesnap.app"
  }
}

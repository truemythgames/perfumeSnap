# Local development
EXPO_PUBLIC_API_URL=http://localhost:8787

# Production (after deploying the Cloudflare Worker)
# EXPO_PUBLIC_API_URL=https://api.perfumesnap.app

# Image CDN (edge-cached R2 worker — set in server/admin wrangler vars)
# MEDIA_BASE_URL=https://media.perfumesnap.app

# Facebook SDK (from developers.facebook.com > Settings)
FB_APP_ID=
FB_CLIENT_TOKEN=

# RevenueCat (Project Settings > API keys — use the *public* SDK keys, not secret keys)
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_XXXXXXXXXXXXXXXXXXXXXXXX
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_XXXXXXXXXXXXXXXXXXXXXXXX
# Must match the entitlement identifier in RevenueCat dashboard
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=premium

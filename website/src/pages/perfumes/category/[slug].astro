---
import Base from "@/layouts/Base.astro";
import DownloadCTA from "@/components/DownloadCTA.astro";
import { getAllCategories, getPerfumesByCategory } from "@/lib/perfumes";
import { breadcrumbJsonLd } from "@/lib/structured-data";
import { SITE_URL } from "@/lib/seo";

export function getStaticPaths() {
  return getAllCategories().map((c) => ({ params: { slug: c.slug } }));
}

const { slug } = Astro.params;
const name = slug!.charAt(0).toUpperCase() + slug!.slice(1);
const perfumes = getPerfumesByCategory(slug!);

const jsonLd = [breadcrumbJsonLd([
  { name: "Home", href: "/" },
  { name: "Perfumes", href: "/perfumes" },
  { name: `${name} Perfumes`, href: `/perfumes/category/${slug}` },
])];
---

<Base
  title={`${name} Perfumes — Best ${name} Fragrances`}
  description={`Discover the best ${name.toLowerCase()} perfumes. Browse ${perfumes.length} ${name.toLowerCase()} fragrances with notes and fragrance family info. Get prices and more in the PerfumeSnap app.`}
  canonical={`${SITE_URL}/perfumes/category/${slug}`}
  jsonLd={jsonLd}
>
  <div class="mx-auto max-w-4xl px-6 py-16 md:py-24">
    <nav class="flex items-center gap-2 text-xs text-muted-dark mb-8">
      <a href="/" class="hover:text-foreground transition-colors">Home</a>
      <span>/</span>
      <a href="/perfumes" class="hover:text-foreground transition-colors">Perfumes</a>
      <span>/</span>
      <span class="text-muted">{name}</span>
    </nav>

    <h1 class="text-3xl md:text-5xl font-bold text-foreground mb-3">{name} Perfumes</h1>
    <p class="text-muted text-lg mb-10">{perfumes.length} {name.toLowerCase()} fragrances to explore.</p>

    <div class="space-y-3 mb-16">
      {perfumes.map((perfume) => (
        <a href={`/perfumes/${perfume.slug}`} class="group flex items-start gap-4 rounded-xl bg-surface border border-border p-4 hover:border-primary/40 transition-all">
          <div class="flex-1 min-w-0">
            <h3 class="text-base font-semibold text-foreground group-hover:text-primary transition-colors">{perfume.name}</h3>
            <p class="text-sm text-muted">{perfume.brand}</p>
            <p class="text-xs text-muted-dark mt-1.5 line-clamp-1">{perfume.topNotes.slice(0, 4).join(" · ")}</p>
          </div>
          <svg class="w-5 h-5 text-muted-dark group-hover:text-primary transition-colors shrink-0 mt-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
        </a>
      ))}
    </div>

    <DownloadCTA variant="banner" heading={`Discover more ${name.toLowerCase()} scents`} subheading="Snap a photo of any bottle. Get the full profile, prices, and similar fragrances — free." />
  </div>
</Base>

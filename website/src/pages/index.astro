---
import Base from "@/layouts/Base.astro";
import DownloadCTA from "@/components/DownloadCTA.astro";
import HeroShowcase from "@/components/HeroShowcase.astro";
import TrustBar from "@/components/TrustBar.astro";
import { appJsonLd, faqJsonLd } from "@/lib/structured-data";

const FEATURES = [
  {
    icon: `<svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6.827 6.175A2.31 2.31 0 0 1 5.186 7.23c-.38.054-.757.112-1.134.175C2.999 7.58 2.25 8.507 2.25 9.574V18a2.25 2.25 0 0 0 2.25 2.25h15A2.25 2.25 0 0 0 21.75 18V9.574c0-1.067-.75-1.994-1.802-2.169a47.865 47.865 0 0 0-1.134-.175 2.31 2.31 0 0 1-1.64-1.055l-.822-1.316a2.192 2.192 0 0 0-1.736-1.039 48.774 48.774 0 0 0-5.232 0 2.192 2.192 0 0 0-1.736 1.039l-.821 1.316Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M16.5 12.75a4.5 4.5 0 1 1-9 0 4.5 4.5 0 0 1 9 0ZM18.75 10.5h.008v.008h-.008V10.5Z" /></svg>`,
    title: "AI Identification",
    description: "Point your camera at any perfume bottle and our AI instantly identifies it with remarkable accuracy.",
  },
  {
    icon: `<svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9.75 3.104v5.714a2.25 2.25 0 0 1-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082m.75-.082a24.301 24.301 0 0 1 4.5 0m0 0v5.714c0 .597.237 1.17.659 1.591L19.8 15.3M14.25 3.104c.251.023.501.05.75.082M19.8 15.3l-1.57.393A9.065 9.065 0 0 1 12 15a9.065 9.065 0 0 0-6.23.693L5 14.5m14.8.8 1.402 1.402c1.232 1.232.65 3.318-1.067 3.611A48.309 48.309 0 0 1 12 21c-2.773 0-5.491-.235-8.135-.687-1.718-.293-2.3-2.379-1.067-3.61L5 14.5" /></svg>`,
    title: "Notes Breakdown",
    description: "Get the complete fragrance pyramid — top, middle, and base notes — along with family, concentration, and character.",
  },
  {
    icon: `<svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>`,
    title: "Price Comparison",
    description: "See live prices from top retailers. Find the best deal on your favorite fragrance without searching manually.",
  },
  {
    icon: `<svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M20.25 8.511c.884.284 1.5 1.128 1.5 2.097v4.286c0 1.136-.847 2.1-1.98 2.193-.34.027-.68.052-1.02.072v3.091l-3-3c-1.354 0-2.694-.055-4.02-.163a2.115 2.115 0 0 1-.825-.242m9.345-8.334a2.126 2.126 0 0 0-.476-.095 48.64 48.64 0 0 0-8.048 0c-1.131.094-1.976 1.057-1.976 2.192v4.286c0 .837.46 1.58 1.155 1.951m9.345-8.334V6.637c0-1.621-1.152-3.026-2.76-3.235A48.455 48.455 0 0 0 11.25 3c-2.115 0-4.198.137-6.24.402-1.608.209-2.76 1.614-2.76 3.235v6.226c0 1.621 1.152 3.026 2.76 3.235.577.075 1.157.14 1.74.194V21l4.155-4.155" /></svg>`,
    title: "Perfume Expert Chat",
    description: "Ask our AI anything about a fragrance — layering tips, performance, alternatives, best occasions.",
  },
  {
    icon: `<svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 7.125C2.25 6.504 2.754 6 3.375 6h6c.621 0 1.125.504 1.125 1.125v3.75c0 .621-.504 1.125-1.125 1.125h-6a1.125 1.125 0 0 1-1.125-1.125v-3.75ZM14.25 8.625c0-.621.504-1.125 1.125-1.125h5.25c.621 0 1.125.504 1.125 1.125v8.25c0 .621-.504 1.125-1.125 1.125h-5.25a1.125 1.125 0 0 1-1.125-1.125v-8.25ZM3.75 16.125c0-.621.504-1.125 1.125-1.125h5.25c.621 0 1.125.504 1.125 1.125v2.25c0 .621-.504 1.125-1.125 1.125h-5.25a1.125 1.125 0 0 1-1.125-1.125v-2.25Z" /></svg>`,
    title: "Your Collection",
    description: "Save every fragrance you discover. Build your personal perfume library, synced across devices.",
  },
  {
    icon: `<svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3v11.25A2.25 2.25 0 0 0 6 16.5h2.25M3.75 3h-1.5m1.5 0h16.5m0 0h1.5m-1.5 0v11.25A2.25 2.25 0 0 1 18 16.5h-2.25m-7.5 0h7.5m-7.5 0-1 3m8.5-3 1 3m0 0 .5 1.5m-.5-1.5h-9.5m0 0-.5 1.5M9 11.25v1.5M12 9v3.75m3-6v6" /></svg>`,
    title: "Smart Recommendations",
    description: "Discover similar fragrances you might love, with live retailer links and price comparisons.",
  },
];

const HOW_IT_WORKS = [
  {
    step: "01",
    title: "Snap a photo",
    description: "Open the camera and take a photo of any perfume bottle. Or pick one from your gallery.",
    detail: "Works on designer, niche, and vintage bottles.",
  },
  {
    step: "02",
    title: "AI identifies it",
    description: "Our AI analyzes the bottle and label to identify the fragrance in seconds.",
    detail: "Notes, concentration, family, and character included.",
  },
  {
    step: "03",
    title: "Explore & save",
    description: "Get the full profile, compare prices, find similar scents, and save to your collection.",
    detail: "Direct links to major retailers when available.",
  },
];

const FAQ_ITEMS = [
  { question: "How does PerfumeSnap identify perfumes?", answer: "PerfumeSnap uses advanced AI vision technology to analyze the bottle, label, and packaging in your photo. It compares these visual cues against an extensive fragrance database to identify the perfume with high accuracy." },
  { question: "Is PerfumeSnap free to use?", answer: "Yes, PerfumeSnap is free to download and use. You can identify perfumes, view fragrance profiles, and build your collection at no cost." },
  { question: "What information do I get when I identify a perfume?", answer: "You get a comprehensive fragrance profile including the perfume name and brand, fragrance family, concentration type, complete notes pyramid (top, middle, base), longevity and sillage ratings, recommended occasions and seasons, price range guidance, and links to buy from top retailers." },
  { question: "Can I identify any perfume brand?", answer: "PerfumeSnap can identify fragrances from virtually any brand — from mainstream designers like Dior, Chanel, and Tom Ford to niche houses like Maison Francis Kurkdjian and Byredo. The AI continuously improves its recognition capabilities." },
  { question: "How accurate is the perfume identification?", answer: "PerfumeSnap achieves high accuracy for most commercial fragrances. For best results, take a clear photo of the bottle front label in good lighting. The AI may occasionally need a second look for very rare or obscure fragrances." },
  { question: "Is my data private?", answer: "Absolutely. PerfumeSnap uses anonymous device IDs — we don't require accounts or personal information. Your photos are processed securely and your collection data is private to your device." },
];

const jsonLd = [appJsonLd(), faqJsonLd(FAQ_ITEMS)];
---

<Base
  description="Identify any perfume instantly with AI. Snap a photo of any fragrance bottle and get the full profile — notes, longevity, price comparison, and where to buy."
  canonical="https://perfumesnap.app/"
  jsonLd={jsonLd}
>
  <!-- Hero -->
  <section id="hero" class="relative overflow-hidden pb-8 md:pb-12">
    <div class="absolute inset-0 bg-linear-to-b from-primary/8 via-transparent to-transparent"></div>
    <div class="absolute inset-0 opacity-20 bg-[radial-gradient(circle_at_70%_20%,rgba(200,148,60,0.25),transparent_45%)]"></div>

    <div class="mx-auto max-w-6xl px-6 pt-20 pb-8 md:pt-28 md:pb-12 relative">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-10 items-center">
        <div class="text-center md:text-left">
          <div class="inline-flex items-center gap-2 bg-primary/10 border border-primary/20 rounded-full px-4 py-1.5 mb-6">
            <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
            <span class="text-xs font-medium text-primary">Free on iOS & Android</span>
          </div>
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight leading-[1.08] mb-5">
            Snap any bottle.<br />
            <span class="text-transparent bg-clip-text bg-linear-to-r from-primary to-accent">Know everything.</span>
          </h1>
          <p class="text-lg text-muted max-w-xl mx-auto md:mx-0 mb-8 leading-relaxed">
            Identify perfumes in seconds, get notes and market prices, compare retailers, and build your collection — all from one photo.
          </p>
          <DownloadCTA variant="hero" />
          <p class="mt-4 text-xs text-muted-dark">No account required · Private by default</p>
        </div>

        <HeroShowcase />
      </div>
    </div>
  </section>

  <TrustBar />

  <!-- Features -->
  <section id="features" class="bg-surface py-24">
    <div class="mx-auto max-w-6xl px-6">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-bold text-foreground mb-4">Everything you need to know about any fragrance</h2>
        <p class="text-muted text-lg max-w-2xl mx-auto">From identification to purchase — PerfumeSnap is your AI-powered fragrance companion.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {FEATURES.map((feature) => (
          <div class="rounded-2xl bg-background border border-border p-6 hover:border-primary/30 transition-colors">
            <div class="w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center text-primary mb-4">
              <Fragment set:html={feature.icon} />
            </div>
            <h3 class="text-lg font-semibold text-foreground mb-2">{feature.title}</h3>
            <p class="text-sm text-muted leading-relaxed">{feature.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="py-24">
    <div class="mx-auto max-w-6xl px-6">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-bold text-foreground mb-4">How it works</h2>
        <p class="text-muted text-lg">Three steps to identify any perfume</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {HOW_IT_WORKS.map((item) => (
          <div class="rounded-2xl border border-border bg-surface/50 p-6 md:p-7">
            <span class="text-4xl font-bold text-primary/25">{item.step}</span>
            <h3 class="text-xl font-semibold text-foreground mt-3 mb-2">{item.title}</h3>
            <p class="text-muted text-sm leading-relaxed mb-3">{item.description}</p>
            <p class="text-xs text-primary/90 font-medium">{item.detail}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-surface py-24 pb-28 md:pb-24">
    <div class="mx-auto max-w-3xl px-6">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-bold text-foreground mb-4">Frequently asked questions</h2>
      </div>
      <div class="space-y-4">
        {FAQ_ITEMS.map((item) => (
          <details class="group rounded-xl bg-background border border-border p-5">
            <summary class="flex items-center justify-between cursor-pointer list-none text-foreground font-medium">
              {item.question}
              <svg class="w-5 h-5 text-muted shrink-0 ml-4 group-open:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
            </summary>
            <p class="mt-4 text-sm text-muted leading-relaxed">{item.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Download CTA -->
  <DownloadCTA variant="banner" />
</Base>

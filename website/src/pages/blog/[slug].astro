---
import Base from "@/layouts/Base.astro";
import DownloadCTA from "@/components/DownloadCTA.astro";
import { getAllPosts, getPostBySlug } from "@/lib/blog";
import { articleJsonLd, breadcrumbJsonLd } from "@/lib/structured-data";
import { SITE_URL } from "@/lib/seo";

export function getStaticPaths() {
  return getAllPosts().map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const post = getPostBySlug(slug!)!;

const jsonLd = [
  articleJsonLd(post),
  breadcrumbJsonLd([
    { name: "Home", href: "/" },
    { name: "Blog", href: "/blog" },
    { name: post.title, href: `/blog/${post.slug}` },
  ]),
];
---

<Base
  title={post.title}
  description={post.description}
  canonical={`${SITE_URL}/blog/${post.slug}`}
  ogType="article"
  article={{ publishedTime: post.publishedAt, tags: post.tags }}
  jsonLd={jsonLd}
>
  <article class="mx-auto max-w-3xl px-6 py-16 md:py-24">
    <nav class="flex items-center gap-2 text-xs text-muted-dark mb-8">
      <a href="/" class="hover:text-foreground transition-colors">Home</a>
      <span>/</span>
      <a href="/blog" class="hover:text-foreground transition-colors">Blog</a>
      <span>/</span>
      <span class="text-muted truncate">{post.title}</span>
    </nav>

    <header class="mb-12">
      <div class="flex flex-wrap gap-2 mb-4">
        {post.tags.map((tag) => (
          <span class="text-xs font-medium text-primary bg-primary/10 px-2.5 py-1 rounded-full">{tag}</span>
        ))}
      </div>
      <h1 class="text-3xl md:text-5xl font-bold text-foreground leading-tight mb-4">{post.title}</h1>
      <p class="text-lg text-muted mb-4">{post.description}</p>
      <time class="text-sm text-muted-dark">
        {new Date(post.publishedAt).toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}
      </time>
    </header>

    <div
      class="prose prose-invert max-w-none
        [&_h2]:text-2xl [&_h2]:font-semibold [&_h2]:text-foreground [&_h2]:mt-10 [&_h2]:mb-4
        [&_h3]:text-lg [&_h3]:font-semibold [&_h3]:text-foreground [&_h3]:mt-8 [&_h3]:mb-3
        [&_p]:text-muted [&_p]:leading-relaxed [&_p]:mb-4
        [&_ul]:text-muted [&_ul]:space-y-2 [&_ul]:mb-4 [&_ul]:list-disc [&_ul]:pl-5
        [&_ol]:text-muted [&_ol]:space-y-2 [&_ol]:mb-4 [&_ol]:list-decimal [&_ol]:pl-5
        [&_li]:leading-relaxed
        [&_strong]:text-foreground
        [&_a]:text-primary [&_a]:underline [&_a]:underline-offset-4 [&_a:hover]:text-accent
        [&_blockquote]:border-l-2 [&_blockquote]:border-primary/40 [&_blockquote]:pl-4 [&_blockquote]:italic [&_blockquote]:text-muted"
      set:html={post.content}
    />

    <div class="mt-16">
      <DownloadCTA />
    </div>
  </article>
</Base>

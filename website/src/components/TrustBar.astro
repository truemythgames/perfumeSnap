---
const ITEMS = [
  { icon: "⚡", label: "Instant AI identification" },
  { icon: "🌸", label: "Full notes & fragrance profile" },
  { icon: "💰", label: "Live retailer price comparison" },
  { icon: "🔒", label: "Private — no account required" },
];
---

<div class="border-y border-border bg-surface/80">
  <div class="mx-auto max-w-6xl px-6 py-5">
    <ul class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6">
      {ITEMS.map((item) => (
        <li class="flex items-center gap-2.5 text-sm text-muted">
          <span class="text-base leading-none" aria-hidden="true">{item.icon}</span>
          <span>{item.label}</span>
        </li>
      ))}
    </ul>
  </div>
</div>

---
/** Visual proof of the product: scan → identify → profile */
---

<div class="hero-showcase" aria-hidden="true">
  <div class="hero-showcase__glow"></div>
  <div class="phone">
    <div class="phone__bezel">
      <div class="phone__notch"></div>
      <div class="phone__screen">
        <img
          src="/app-scan-preview.png"
          alt=""
          width="390"
          height="520"
          class="phone__scan"
          loading="eager"
          decoding="async"
        />
        <div class="phone__scan-ui">
          <div class="phone__scan-frame"></div>
          <span class="phone__scan-label">Point at any bottle</span>
        </div>
      </div>
    </div>
  </div>

  <div class="result-card">
    <div class="result-card__badge">Identified</div>
    <p class="result-card__brand">Chanel</p>
    <h3 class="result-card__name">Bleu de Chanel</h3>
    <p class="result-card__meta">Eau de Parfum · Woody Aromatic</p>
    <div class="result-card__chips">
      <span>Citrus</span>
      <span>Cedar</span>
      <span>Incense</span>
    </div>
    <div class="result-card__price">
      <span class="result-card__price-label">Live prices from</span>
      <strong>$89 – $128</strong>
    </div>
  </div>
</div>

<style>
  .hero-showcase {
    position: relative;
    width: min(100%, 22rem);
    margin-inline: auto;
    aspect-ratio: 4 / 5;
  }

  .hero-showcase__glow {
    position: absolute;
    inset: 8% 0 0;
    background: radial-gradient(circle at 50% 30%, rgba(200, 148, 60, 0.35), transparent 62%);
    filter: blur(24px);
    pointer-events: none;
  }

  .phone {
    position: absolute;
    inset: 0 12% 8% 0;
    z-index: 1;
  }

  .phone__bezel {
    height: 100%;
    border-radius: 2.4rem;
    padding: 0.55rem;
    background: linear-gradient(145deg, #3a342e, #12100e);
    box-shadow:
      0 24px 60px rgba(0, 0, 0, 0.55),
      inset 0 1px 0 rgba(255, 255, 255, 0.08);
  }

  .phone__notch {
    position: absolute;
    top: 0.85rem;
    left: 50%;
    transform: translateX(-50%);
    width: 34%;
    height: 1.35rem;
    border-radius: 999px;
    background: #0c0a08;
    z-index: 3;
  }

  .phone__screen {
    position: relative;
    height: 100%;
    border-radius: 1.95rem;
    overflow: hidden;
    background: #0c0a08;
  }

  .phone__scan {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 35%;
  }

  .phone__scan-ui {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding-top: 2rem;
    background: linear-gradient(to bottom, rgba(12, 10, 8, 0.15), rgba(12, 10, 8, 0.45));
  }

  .phone__scan-frame {
    width: 58%;
    aspect-ratio: 3 / 4;
    border: 2px solid rgba(212, 164, 74, 0.85);
    border-radius: 1rem;
    box-shadow: 0 0 0 9999px rgba(12, 10, 8, 0.35);
  }

  .phone__scan-label {
    margin-top: 1rem;
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: rgba(242, 236, 228, 0.88);
    background: rgba(12, 10, 8, 0.55);
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
  }

  .result-card {
    position: absolute;
    right: 0;
    bottom: 0;
    z-index: 2;
    width: 72%;
    padding: 1rem 1rem 1.1rem;
    border-radius: 1.15rem;
    border: 1px solid rgba(200, 148, 60, 0.25);
    background: linear-gradient(160deg, rgba(30, 26, 22, 0.96), rgba(12, 10, 8, 0.98));
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(12px);
  }

  .result-card__badge {
    display: inline-block;
    margin-bottom: 0.55rem;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    background: rgba(78, 173, 78, 0.15);
    color: #4ead4e;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .result-card__brand {
    margin: 0;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #a49882;
  }

  .result-card__name {
    margin: 0.15rem 0 0.35rem;
    font-size: 1.05rem;
    line-height: 1.2;
    font-weight: 700;
    color: #f2ece4;
  }

  .result-card__meta {
    margin: 0 0 0.75rem;
    font-size: 0.78rem;
    color: #a49882;
  }

  .result-card__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-bottom: 0.85rem;
  }

  .result-card__chips span {
    padding: 0.22rem 0.55rem;
    border-radius: 999px;
    background: rgba(200, 148, 60, 0.12);
    color: #d4a44a;
    font-size: 0.68rem;
    font-weight: 600;
  }

  .result-card__price {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
    padding-top: 0.65rem;
    border-top: 1px solid rgba(42, 36, 32, 0.9);
  }

  .result-card__price-label {
    font-size: 0.68rem;
    color: #665c50;
  }

  .result-card__price strong {
    font-size: 0.92rem;
    color: #f2ece4;
  }

  @media (min-width: 768px) {
    .hero-showcase {
      width: min(100%, 26rem);
      margin-inline: 0;
    }
  }
</style>
